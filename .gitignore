# Kairos is an UMBRELLA folder. Every package below is an independent git
# repository + cargo workspace, deployed to GitHub on its own by `kairos deploy`.
# They are therefore ignored here rather than tracked as submodules.
/rusty_rtos_*/
/rusty_rtos-*/
/kairos-*/
/tools/kairos/target/
**/target/
# The C oracle checkouts and build products (pinned in ORACLES.md, fetched by
# `kairos oracle fetch`); the harness sources beside them ARE tracked.
/oracle/FreeRTOS-Kernel/
/oracle/FreeRTOS/
/oracle/build/
# The plain oracle traces: the tracked form is the zstd frame beside them,
# which `kairos oracle trace` writes only after two runs agree byte for
# byte. The .sim/.oracle pair is `kairos conform` scratch — rewritten at
# whatever length it was last asked for, so tracking it churns megabytes
# per run and proves nothing the pinned digests in rusty_rtos_demo's
# tests/conformance.rs do not prove better.
/oracle/traces/*.trace
/oracle/traces/*.sim
/oracle/traces/*.oracle
*.log
.DS_Store
Thumbs.db

# Recordings from bench/kernel-ir: callgrind dumps, 16MB and regenerable.
bench/kernel-ir/out/
# Same, from bench/sb-ir. `out3` is the third corpus shape a kernel-wide
# probe has to be checked against; both are rebuilt by one run.
bench/sb-ir/out/
bench/sb-ir/out3/

# K7 library oracles, cloned at their ORACLES.md pins by
# `kairos oracle fetch --lib <name>`. Pinned, not vendored: the same
# arrangement as oracle/FreeRTOS-Kernel.
oracle/backoffAlgorithm/
oracle/coreJSON/
oracle/coreSNTP/
oracle/coreMQTT/
oracle/coreHTTP/
oracle/FreeRTOS-Plus-TCP/

# The interop and throughput rigs write their peer config, their peer script
# and their per-rep output beside themselves and delete them on exit. They
# are visible only while a rig is MID-RUN -- which is exactly when someone
# is most likely to stage a commit -- so they are ignored rather than
# trusted to clean up.
/tools/vertical/.mosquitto.conf
/tools/vertical/.rumqttd.toml
/tools/vertical/.peer.py
/tools/vertical/.peer.*.out
/tools/vertical/.rates
